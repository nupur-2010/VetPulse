generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum UserRole {
  FARMER
  VETERINARIAN
  ADMIN
}

enum Gender {
  MALE
  FEMALE
}

enum PregnancyStatus {
  NOT_PREGNANT
  PREGNANT
  UNKNOWN
}

enum ReportStatus {
  PENDING
  AI_COMPLETED
  VET_REVIEWED
  CONFIRMED
}

enum PredictionStatus {
  PENDING
  COMPLETED
  FAILED
  UNAVAILABLE
}

enum ReviewDecision {
  AGREES_AI
  DISAGREES_AI
  INCONCLUSIVE
  ALTERNATIVE_DISEASE
  NEEDS_EXAMINATION
}

enum ConsultationStatus {
  REQUESTED
  ACCEPTED
  REJECTED
  COMPLETED
  CLOSED
}

enum ClusterStatus {
  POTENTIAL
  UNDER_INVESTIGATION
  SUSPECTED_OUTBREAK
  LAB_CONFIRMED
  DISMISSED
}

enum VerificationStatus {
  UNVERIFIED
  VERIFIED
  REJECTED
}

// Users and Authentication
model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  role          UserRole
  isActive      Boolean   @default(true)
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  farmerProfile   FarmerProfile?
  vetProfile      VetProfile?
  refreshTokens   RefreshToken[]
  auditLogs       AuditLog[]

  @@index([email])
  @@index([role])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// Farmer Data
model FarmerProfile {
  id           String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName     String
  lastName      String
  phone         String?
  address       String?
  state         String
  district      String
  village       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  farm         Farm?
  cattle       Cattle[]
  healthReports HealthReport[]
  consultations Consultation[]

  @@index([userId])
}

model Farm {
  id           String   @id @default(uuid())
  farmerId     String   @unique
  farmer       FarmerProfile @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  name         String
  location     String?
  latitude     Float?
  longitude    Float?
  address      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cattle       Cattle[]
}

model Cattle {
  id               String    @id @default(uuid())
  farmId           String
  farm             Farm      @relation(fields: [farmId], references: [id], onDelete: Cascade)
  ownerId          String
  owner            FarmerProfile @relation(fields: [ownerId], references: [id])
  tagNumber        String
  name             String?
  breed            String
  gender           Gender
  dateOfBirth      DateTime?
  estimatedAge     String?
  weight           Float?
  identificationMarks String?
  pregnancyStatus PregnancyStatus @default(UNKNOWN)
  isActive         Boolean   @default(true)
  archivedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  photos       CattlePhoto[]
  vaccinations CattleVaccination[]
  healthReports HealthReport[]

  @@unique([farmId, tagNumber])
  @@index([ownerId])
  @@index([tagNumber])
}

model CattlePhoto {
  id        String   @id @default(uuid())
  cattleId  String
  cattle    Cattle   @relation(fields: [cattleId], references: [id], onDelete: Cascade)
  photoUrl  String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
}

model CattleVaccination {
  id          String   @id @default(uuid())
  cattleId    String
  cattle      Cattle   @relation(fields: [cattleId], references: [id], onDelete: Cascade)
  vaccineName String
  dateGiven   DateTime
  nextDueDate DateTime?
  notes       String?
  createdAt   DateTime @default(now())
}

// Health Reports
model HealthReport {
  id                  String       @id @default(uuid())
  reportNumber        String       @unique @default(uuid())
  cattleId            String
  cattle              Cattle       @relation(fields: [cattleId], references: [id], onDelete: Cascade)
  farmerId            String
  farmer              FarmerProfile @relation(fields: [farmerId], references: [id])
  
  // Location
  state               String
  district           String
  village            String?
  latitude           Float?
  longitude           Float?
  location            String? // Combined address
  
  // Clinical info
  temperature         Float?
  symptomDuration     String
  severity            String       @default("mild")
  milkProductionChange String?
  waterIntakeChange   String?
  recentVaccination   String?
  recentIllness       String?
  recentTreatment     String?
  additionalNotes     String?
  
  // Status
  status              ReportStatus @default(PENDING)
  consultationRequested Boolean   @default(false)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  symptoms      HealthReportSymptom[]
  photos        HealthReportPhoto[]
  prediction    Prediction?
  consultations Consultation[]

  @@index([cattleId])
  @@index([farmerId])
  @@index([status])
  @@index([createdAt])
  @@index([district, createdAt])
}

model HealthReportSymptom {
  id           String   @id @default(uuid())
  reportId     String
  report       HealthReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  symptomName  String
  symptomGroup String
  createdAt    DateTime @default(now())

  @@index([reportId])
}

model HealthReportPhoto {
  id        String   @id @default(uuid())
  reportId  String
  report    HealthReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  photoUrl  String
  createdAt DateTime @default(now())

  @@index([reportId])
}

// AI Predictions
model Prediction {
  id                     String           @id @default(uuid())
  reportId               String           @unique
  report                 HealthReport     @relation(fields: [reportId], references: [id], onDelete: Cascade)
  
  predictionId           String           @unique // From AI service
  provider               String           @default("mock") // mock or model
  modelStatus            String           @default("MOCK") // MOCK, LOADED, ERROR
  isSimulated            Boolean          @default(true)
  
  predictedDisease       String?
  confidence             Float?
  confidenceInterpretation String?
  severity               String?
  
  supportingSymptoms     String[]
  recommendations        String[]
  
  imageAssessmentStatus   String           @default("not_analyzed")
  imageAssessmentNote     String?
  
  disclaimer             String
  predictionTimestamp    DateTime         @default(now())
  
  status                 PredictionStatus @default(PENDING)
  errorMessage           String?
  
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  candidates      PredictionCandidate[]
  vetReviews      PredictionReview[]

  @@index([reportId])
  @@index([predictedDisease])
  @@index([status])
}

model PredictionCandidate {
  id            String    @id @default(uuid())
  predictionId  String
  prediction    Prediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)
  disease       String
  confidence    Float
  createdAt     DateTime  @default(now())

  @@index([predictionId])
}

// Veterinary Data
model VetProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName    String
  lastName     String
  phone        String?
  specialization String?
  licenseNumber String?
  licenseState  String?
  yearsOfExperience Int?
  clinicName    String?
  clinicAddress String?
  consultationFee Float?
  rating        Float?
  totalReviews  Int      @default(0)
  isAvailable   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  reviews      PredictionReview[]
  consultations Consultation[]
  availability VetAvailability[]

  @@index([userId])
}

model VetAvailability {
  id         String   @id @default(uuid())
  vetId      String
  vet        VetProfile @relation(fields: [vetId], references: [id], onDelete: Cascade)
  dayOfWeek  Int      // 0 = Sunday, 6 = Saturday
  startTime  String   // HH:mm format
  endTime    String   // HH:mm format
  isAvailable Boolean @default(true)
  createdAt  DateTime @default(now())

  @@index([vetId])
}

// Prediction Reviews by Veterinarians
model PredictionReview {
  id               String   @id @default(uuid())
  predictionId     String
  prediction       Prediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)
  vetId            String
  vet              VetProfile @relation(fields: [vetId], references: [id])
  
  decision         ReviewDecision
  confidence       Float?
  notes            String?
  alternativeDiagnosis String?
  recommendedActions String?
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([predictionId])
  @@index([vetId])
}

// Consultations
model Consultation {
  id            String   @id @default(uuid())
  reportId      String
  report        HealthReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  vetId         String
  vet           VetProfile @relation(fields: [vetId], references: [id])
  farmerId      String
  farmer        FarmerProfile @relation(fields: [farmerId], references: [id])
  
  status        ConsultationStatus @default(REQUESTED)
  
  // Scheduling
  scheduledAt   DateTime?
  duration      Int?      // in minutes
  
  // Details
  reason        String?
  findings      String?
  diagnosis     String?
  treatmentPlan String?
  medications   String?
  followUpDate  DateTime?
  
  // Feedback
  farmerRating  Int?
  farmerFeedback String?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([reportId])
  @@index([vetId])
  @@index([farmerId])
  @@index([status])
}

// Disease Clusters for Outbreak Detection
model DiseaseCluster {
  id           String   @id @default(uuid())
  name         String?
  disease      String
  status       ClusterStatus @default(POTENTIAL)
  
  // Geographic bounds
  centerLatitude Float
  centerLongitude Float
  radiusKm       Float   @default(10)
  
  // Time bounds
  firstReportAt DateTime
  lastReportAt  DateTime
  
  // Counts
  reportCount   Int      @default(0)
  cattleAffected Int      @default(0)
  
  // Investigation
  notes         String?
  investigatedBy String?
  investigatedAt DateTime?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  reportIds     String[] // Array of report IDs in this cluster
  alerts        OutbreakAlert[]

  @@index([disease])
  @@index([status])
  @@index([centerLatitude, centerLongitude])
}

// Outbreak Alerts
model OutbreakAlert {
  id           String   @id @default(uuid())
  clusterId    String?
  cluster      DiseaseCluster? @relation(fields: [clusterId], references: [id])
  
  disease      String
  severity     String   // LOW, MEDIUM, HIGH, CRITICAL
  state        String
  district     String
  
  message      String
  recommendations String[]
  
  isActive     Boolean  @default(true)
  expiresAt    DateTime?
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([disease])
  @@index([state, district])
  @@index([isActive])
}

// Audit Logs
model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String
  entityType String?
  entityId   String?
  details    String?  // JSON string
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// Analytics Models (for aggregated data)
model DailyReportStats {
  id           String   @id @default(uuid())
  date         DateTime
  state        String
  district     String
  
  totalReports Int      @default(0)
  aiProcessed  Int      @default(0)
  vetReviewed  Int      @default(0)
  confirmedCases Int    @default(0)
  
  diseaseBreakdown String? // JSON string
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([date, state, district])
  @@index([date])
  @@index([state, district])
}
