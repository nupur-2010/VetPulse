# Application
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://vetpulse:vetpulse_secret_password@localhost:5432/vetpulse

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AI Service
AI_SERVICE_URL=http://localhost:8000
AI_PROVIDER=mock

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Email (for production)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@vetpulse.com
SMTP_PASS=email_password
EMAIL_FROM=noreply@vetpulse.com

# Outbreak Detection
OUTBREAK_MIN_ANIMALS=3
OUTBREAK_RADIUS_KM=5
OUTBREAK_TIME_WINDOW_DAYS=14
